{
  "version": 2,
  "builds": [
    {
      "src": "campus_transport/campus_transport/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    },
    {
      "src": "campus_transport/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "campus_transport/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "campus_transport/campus_transport/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "campus_transport.settings",
    "DJANGO_DEBUG": "False",
    "PYTHONPATH": "campus_transport"
  }
}
